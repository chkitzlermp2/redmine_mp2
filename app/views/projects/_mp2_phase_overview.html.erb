<%# mp2 phase/state overview, inserted before the Tickets box on the project %>
<%# overview via the base_content hook (positioned by mp2.js). Uses the %>
<%# controller instance var @open_issues_by_state (a hash keyed by status id) %>
<%# set by ProjectsControllerPatch, so no locals are needed. %>
<%#
  Column order and status ids match the Redmine instance's 16-column layout:
  Phase 1 (Planungsphase): reported=1, offering=15, next_meeting=2,
    processing_customer=3, offered=4
  Phase 2 (Ticketphase): adopted=7, in_progress=8, examination_mp2=9,
    deploy=17, in_test_test=10, in_test_live=16, feedback=13, released=11
  Phase 3 (Nachverfolgung): shifted=6, rejected=5, completed=12
%>
<% counts = @open_issues_by_state %>
<% if @project && @trackers.present? && counts.present? && User.current.allowed_to?(:view_issues, @project) %>
<div class="mp2-phase-overview">
  <div class="issues box">
    <h3 class="icon icon-group"><%= l(:label_mp2_state) %></h3>
    <table class="list issue-report">
      <thead>
        <tr>
          <th></th>
          <th colspan="5"><%= l(:label_mp2_phase_1) %></th>
          <th colspan="8"><%= l(:label_mp2_phase_2) %></th>
          <th colspan="3"><%= l(:label_mp2_phase_3) %></th>
        </tr>
        <tr>
          <th></th>
          <th><%= l(:label_mp2_reported) %></th>
          <th><%= l(:label_mp2_offering) %></th>
          <th><%= l(:label_mp2_next_meeting) %></th>
          <th><%= l(:label_mp2_processing_customer) %></th>
          <th><%= l(:label_mp2_offered) %></th>
          <th><%= l(:label_mp2_adopted) %></th>
          <th><%= l(:label_mp2_in_progress) %></th>
          <th><%= l(:label_mp2_in_examination_mp2) %></th>
          <th><%= l(:label_mp2_deploy) %></th>
          <th><%= l(:label_mp2_in_test_test) %></th>
          <th><%= l(:label_mp2_in_test_live) %></th>
          <th><%= l(:label_mp2_feedback) %></th>
          <th><%= l(:label_mp2_released) %></th>
          <th><%= l(:label_mp2_shifted_on_indefinite) %></th>
          <th><%= l(:label_mp2_rejected) %></th>
          <th><%= l(:label_mp2_completed) %></th>
        </tr>
      </thead>
      <tbody>
        <% @trackers.each do |tracker| %>
          <tr class="<%= cycle('odd', 'even') %>">
            <td class="name">
              <%= link_to tracker.name, project_issues_path(@project, :set_filter => 1, :tracker_id => tracker.id) %>
            </td>
            <% [1, 15, 2, 3, 4, 7, 8, 9, 17, 10, 16, 13, 11, 6, 5, 12].each do |sid| %>
              <td>
                <%= link_to (counts[sid] || {})[tracker].to_i,
                      project_issues_path(@project, :set_filter => 1,
                        :tracker_id => tracker.id, :status_id => sid) %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
    <p>
      <%= link_to l(:label_issue_view_all), project_issues_path(@project, :set_filter => 1) %>
      | <%= link_to l(:field_summary), project_issues_report_path(@project) %>
    </p>
  </div>
</div>
<% end %>
